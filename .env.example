# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only. Never expose to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Public URL of the deployed site (used for share links and login redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email domain shown as the login placeholder
NEXT_PUBLIC_TEAM_EMAIL_DOMAIN=prezlab.com

# Serve proposals in an isolated sandbox so their scripts can't touch team sessions.
# Set to "false" only if a proposal needs localStorage/cookies and breaks.
PROPOSAL_SANDBOX=true

# Shrink proposals that are wider than the screen (phones, small windows) so
# nothing is cut off. Pages that already fit are never touched.
PROPOSAL_FIT=true

# --- Odoo sign-in ----------------------------------------------------------
# Team members sign in with their Odoo login and password (2FA supported).
# The password is checked against Odoo and never stored.
ODOO_URL=https://prezlab.odoo.com
ODOO_DB=your-odoo-database-name
# Optional extra filter on Odoo emails. members.txt and HUB_WHITELIST below are the real access lists.
ODOO_ALLOWED_EMAIL_DOMAIN=prezlab.com

# Seals Odoo trusted-device keys before they are stored, so 2FA users are asked
# for a code once every 30 days instead of every sign-in. These keys are 2FA
# bypass tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it only means everyone is asked for a code once more.
ODOO_TD_ENCRYPTION_KEY=

# --- Proposals Hub access --------------------------------------------------
# Two lists:
#   members.txt    everyone who can sign in and view (see members.example.txt).
#                  A file, not a variable, because it holds the whole company.
#   HUB_WHITELIST  who can also upload, edit, share, retire links and delete.
#                  They're always members too. Comma separated. Edit and
#                  restart (or redeploy) to change it.
HUB_WHITELIST=first.person@prezlab.com, second.person@prezlab.com

# Optional: read the member list from somewhere other than ./members.txt or
# /etc/secrets/members.txt (Render Secret File).
# HUB_MEMBERS_FILE=

# Encrypts proposal passwords and signs client access cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it signs every client out and makes stored passwords unreadable.
HUB_SECRET=
